BEGIN:VEVENT
UID:light-goose-western-20261107@md-hunting-calendars
DTSTAMP:20260817T194017Z
DTSTART;VALUE=DATE:20261107
DTEND;VALUE=DATE:20261108
SUMMARY:Light Goose - Western
DESCRIPTION:Light Goose Season\, Western Zone (the statewide date ranges 
 only\; the Feb 8-Mar 10 extension is Eastern Zone only). Bag: 25/day\, no
  possession limit. May include greater/lesser snow geese and Ross's geese
 . Shooting hours: 1/2 hour before sunrise to sunset.
CLASS:PRIVATE
TRANSP:TRANSPARENT
X-MICROSOFT-CDO-BUSYSTATUS:FREE
X-MICROSOFT-CDO-INTENDEDSTATUS:FREE
X-APPLE-CALENDAR-COLOR:#006400
CATEGORIES:Hunting,Migratory Game Birds
END:VEVENT
