BEGIN:VEVENT
UID:canada-goose-early-resident-western-20260901@md-hunting-calendars
DTSTAMP:20260817T194017Z
DTSTART;VALUE=DATE:20260901
DTEND;VALUE=DATE:20260902
SUMMARY:Canada Goose - Early Resident Western
DESCRIPTION:Early Resident Canada Goose Season\, Western Zone. Bag: 8/day
 \, possession limit 24. Shooting hours: 1/2 hour before sunrise to 1/2 ho
 ur after sunset. Shotguns holding more than 3 shells are permitted during
  this September season only.
CLASS:PRIVATE
TRANSP:TRANSPARENT
X-MICROSOFT-CDO-BUSYSTATUS:FREE
X-MICROSOFT-CDO-INTENDEDSTATUS:FREE
X-APPLE-CALENDAR-COLOR:#006400
CATEGORIES:Hunting,Migratory Game Birds
