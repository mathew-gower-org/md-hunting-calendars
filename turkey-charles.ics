BEGIN:VEVENT
UID:turkey-turkey-charles-20270121@md-hunting-calendars
DTSTAMP:20260813T212152Z
DTSTART;VALUE=DATE:20270121
DTEND;VALUE=DATE:20270122
SUMMARY:Turkey - A/F
DESCRIPTION:Winter Season. Legal devices: crossbow\, vertical bow\, and a
 rrow/bolt-shooting air guns (A)\; shotgun (#4 shot or smaller) or arrow/b
 olt-shooting air gun (F). 1 turkey of either sex\; combined bag limit sha
 red with the Fall Season (1 total for Fall + Winter combined). Shooting h
 ours: 1/2 hour before sunrise to sunset. It is illegal to hunt turkeys wi
 th the aid of bait\, or to use dogs or organized drives.
CLASS:PRIVATE
TRANSP:TRANSPARENT
X-MICROSOFT-CDO-BUSYSTATUS:FREE
X-MICROSOFT-CDO-INTENDEDSTATUS:FREE
X-APPLE-CALENDAR-COLOR:#006400
CATEGORIES:Hunting,Wild Turkey
END:VEVENT
