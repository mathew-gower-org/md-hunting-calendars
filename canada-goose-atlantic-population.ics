BEGIN:VEVENT
UID:canada-goose-atlantic-population-20261124@md-hunting-calendars
DTSTAMP:20260817T194017Z
DTSTART;VALUE=DATE:20261124
DTEND;VALUE=DATE:20261125
SUMMARY:Canada Goose - Atlantic Population
DESCRIPTION:Migratory Canada Goose (Atlantic Population) Season\, single 
 zone (not further split East/West). Bag: 2/day\, possession limit 6\; may
  include Canada\, cackling\, and white-fronted geese. Shooting hours: 1/2
  hour before sunrise to sunset.
CLASS:PRIVATE
TRANSP:TRANSPARENT
X-MICROSOFT-CDO-BUSYSTATUS:FREE
X-MICROSOFT-CDO-INTENDEDSTATUS:FREE
X-APPLE-CALENDAR-COLOR:#006400
CATEGORIES:Hunting,Migratory Game Birds
END:VEVENT
