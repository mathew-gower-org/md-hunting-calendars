X-WR-TIMEZONE:America/New_York
X-APPLE-CALENDAR-COLOR:#006400
X-OUTLOOK-COLOR:#006400
BEGIN:VTIMEZONE
TZID:America/New_York
X-LIC-LOCATION:America/New_York
BEGIN:DAYLIGHT
TZOFFSETFROM:-0500
TZOFFSETTO:-0400
TZNAME:EDT
DTSTART:19700308T020000
RRULE:FREQ=YEARLY;BYMONTH=3;BYDAY=2SU
END:DAYLIGHT
BEGIN:STANDARD
TZOFFSETFROM:-0400
TZOFFSETTO:-0500
TZNAME:EST
DTSTART:19701101T020000
RRULE:FREQ=YEARLY;BYMONTH=11;BYDAY=1SU
END:STANDARD
END:VTIMEZONE
BEGIN:VEVENT
UID:regular-duck-eastern-20261010@md-hunting-calendars
DTSTAMP:20260817T194017Z
DTSTART;VALUE=DATE:20261010
DTEND;VALUE=DATE:20261011
SUMMARY:Regular Duck - Eastern
DESCRIPTION:Regular Duck Season\, Eastern Zone. Bag: 6 ducks/day per spec
 ies sub-limits (4 mallards max 2 hens\, 3 wood ducks\, 2 canvasbacks\, 3 
 pintails\, 2 redheads\, 1 scaup/day (2/day Jan 8-30)\, 4 sea ducks max 3 
 scoters/long-tails/eiders\, 1 fulvous tree duck\, 1 mottled duck)\; plus 
 15 coots/day. Possession limit 3x daily bag. No open season for harlequin
  duck. Shooting hours: 1/2 hour before sunrise to sunset.
CLASS:PRIVATE
TRANSP:TRANSPARENT
X-MICROSOFT-CDO-BUSYSTATUS:FREE
X-MICROSOFT-CDO-INTENDEDSTATUS:FREE
X-APPLE-CALENDAR-COLOR:#006400
CATEGORIES:Hunting,Migratory Game Birds
END:VEVENT
