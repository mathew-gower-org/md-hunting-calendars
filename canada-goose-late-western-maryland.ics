DTSTAMP:20260817T194017Z
DTSTART;VALUE=DATE:20261121
DTEND;VALUE=DATE:20261122
SUMMARY:Canada Goose - Late Western Maryland
DESCRIPTION:Late Western Maryland Resident Canada Goose Season. Bag: 5/da
 y\, possession limit 15 throughout. May include Canada\, cackling\, and w
 hite-fronted geese. Shooting hours: 1/2 hour before sunrise to sunset.
CLASS:PRIVATE
TRANSP:TRANSPARENT
X-MICROSOFT-CDO-BUSYSTATUS:FREE
X-MICROSOFT-CDO-INTENDEDSTATUS:FREE
X-APPLE-CALENDAR-COLOR:#006400
CATEGORIES:Hunting,Migratory Game Birds
END:VEVENT
