BEGIN:VCALENDAR
VERSION:2.0
PRODID:-//md-hunting-calendars//teal-eastern//EN
CALSCALE:GREGORIAN
METHOD:PUBLISH
X-WR-CALNAME:Teal - Eastern
X-WR-TIMEZONE:America/New_York
X-APPLE-CALENDAR-COLOR:#006400
X-OUTLOOK-COLOR:#006400
BEGIN:VTIMEZONE
TZID:America/New_York
X-LIC-LOCATION:America/New_York
BEGIN:DAYLIGHT
TZOFFSETFROM:-0500
TZOFFSETTO:-0400
TZNAME:EDT
DTSTART:19700308T020000
RRULE:FREQ=YEARLY;BYMONTH=3;BYDAY=2SU
END:DAYLIGHT
BEGIN:STANDARD
TZOFFSETFROM:-0400
TZOFFSETTO:-0500
TZNAME:EST
DTSTART:19701101T020000
RRULE:FREQ=YEARLY;BYMONTH=11;BYDAY=1SU
END:STANDARD
END:VTIMEZONE
BEGIN:VEVENT
UID:teal-eastern-20260917@md-hunting-calendars
DTSTAMP:20260817T194017Z
DTSTART;VALUE=DATE:20260917
DTEND;VALUE=DATE:20260918
SUMMARY:Teal - Eastern
DESCRIPTION:Special September Teal Season. Bag: 6 teal/day (blue-winged a
 nd/or green-winged)\, possession limit 18. Shooting hours: 1/2 hour befor
 e sunrise to sunset. Open only in the Eastern-zone-footprint counties (se
 e cache 'note' for county list)\; not a statewide season despite the titl
 e format convention.
CLASS:PRIVATE
TRANSP:TRANSPARENT
X-MICROSOFT-CDO-BUSYSTATUS:FREE
X-MICROSOFT-CDO-INTENDEDSTATUS:FREE
X-APPLE-CALENDAR-COLOR:#006400
CATEGORIES:Hunting,Migratory Game Birds
END:VEVENT
